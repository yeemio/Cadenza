{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cadenza/contracts": ["packages/contracts/src/index.ts"],
      "@cadenza/domain": ["packages/domain/src/index.ts"],
      "@cadenza/application": ["packages/application/src/index.ts"],
      "@cadenza/persistence": ["packages/persistence/src/index.ts"],
      "@cadenza/integrations": ["packages/integrations/src/index.ts"],
      "@cadenza/ui": ["packages/ui/src/index.ts"],
      "@cadenza/testkit": ["packages/testkit/src/index.ts"]
    }
  }
}
