    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.1",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "pg": "^8.16.0",
    "supertest": "^7.1.0"
