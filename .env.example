# Cadenza 开发环境变量样例 —— 复制为 .env 使用（各脚本均有同值默认，不建 .env 也可在 compose 起后运行）
# 数据库：docker compose up -d 启动 cadenza-dev-pg（postgres:17-alpine）
# 宿主端口为 55433：合同原定 55432 已被其他项目容器（cadence-pg-1）占用，启动前 lsof 检查后替换并记录
DATABASE_URL=postgres://postgres:cadenza_dev@127.0.0.1:55433/cadenza

# API 端口：原定 3000 已被其他项目容器（cadence-server-1）占用，默认改为 3001
PORT=3001

# worker：outbox 认领间隔与批量上限
WORKER_INTERVAL_MS=5000
WORKER_BATCH_LIMIT=10

# 前端 dev 服务器调用的 API 地址（apps/web、apps/pda）
VITE_API_BASE_URL=http://127.0.0.1:3001

# ---- P1-S2 组织与权限（auth）----
# 会话有效期（分钟，实现参数）
AUTH_SESSION_TTL_MINUTES=720
# 登录失败锁定阈值与锁定时长（分钟，实现参数；原文只定义锁定缓存与解封动作，未定量）
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOCK_MINUTES=15
# OA-15 系统参数 account.initPassword（未配置时重置密码兜底 '123456'）
# ACCOUNT_INIT_PASSWORD=

# ---- P1-S2 演示种子 dev 凭据（占值，仅 dev；生产另行签发。库中只存 scrypt 散列）----
#   admin / CadAdmin001      华东电缆集团 企业范围管理员（org.read/org.admin/org.role.admin）
#   szqc01 / SzQuality01     苏州厂 质检员（plant 范围 PLNT-SZ + org.read）
#   szws01 / SzWorkshop01    苏州厂 车间主任（workshop 范围 WC-SZ-JZ-01 + org.read）
#   hfadmin01 / HfPlant0001  合肥厂 厂区管理员（plant 范围 PLNT-HF + org.read/org.admin）
#   gzadmin01 / GzPlant00001 南方电缆集团 企业范围管理员
#   disabled01 / SzDisable01 禁用演示账号（OA-16 登录拒绝演示）
# 运行 `pnpm db:seed` 写入/刷新（幂等，凭据经 scrypt 散列入库）

